# Build
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# IDE
.idea
*.iws
*.iml
*.ipr
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
.vscode/

# Cursor
.cursor/

# Documentation and rules (local — not committed)
*.md
*.mdc

# JSON (Postman collections, environments, local exports — not committed)
*.json

# SQL scripts (local / reference DDL — not committed)
*.sql

# Application config (environment-specific secrets and URLs — not committed)
**/application.properties
**/application-*.properties
!**/application.properties.example

# Secrets
.env
.env.*
